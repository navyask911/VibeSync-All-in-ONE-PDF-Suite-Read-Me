rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Zero-Cost End-to-End Encrypted Messaging (Firebase + Signal Protocol)
    match /public_profiles/{phoneNumber} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.phone_number == phoneNumber || request.auth.uid == phoneNumber);
    }

    match /registration_bundles/{phoneNumber} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.phone_number == phoneNumber || request.auth.uid == phoneNumber);
    }

    match /messages/{phoneNumber}/{messageId} {
      // Recipient reads and deletes to keep storage footprint at zero
      allow read, delete: if request.auth != null && (request.auth.token.phone_number == phoneNumber || request.auth.uid == phoneNumber);
      // Authenticated sender writes encrypted payload to recipient's transient queue
      allow create, write: if request.auth != null;
    }

    // Default match for other collections in the app
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
