<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Full-Bleed Background (Entire 108x108 Canvas - Zero White Borders) -->
    <!-- Custom Original VibeSync Palette: Deep Midnight Violet to Neon Coral Rose -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#15082E" />
                <item android:offset="0.4" android:color="#4A148C" />
                <item android:offset="0.75" android:color="#7C4DFF" />
                <item android:offset="1.0" android:color="#FF2A6D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top-Right Cyan Ambient Glow for Luminous Depth -->
    <path
        android:pathData="M30,0 L108,0 L108,80 L30,80 Z"
        android:fillAlpha="0.22">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="108"
                android:startY="0"
                android:endX="40"
                android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F2FE" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft Radial Center Highlight -->
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z"
        android:fillAlpha="0.12">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="30"
                android:gradientRadius="55"
                android:type="radial">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
