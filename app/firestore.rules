rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // FCM token registration for devices
    match /fcm_tokens/{tokenId} {
      allow read, write: if true;
    }
    
    // Chat messages triggered by match participants
    match /chats/{matchId}/messages/{messageId} {
      allow read, write: if true;
    }

    // Matches collection
    match /matches/{matchId} {
      allow read, write: if true;
    }

    // Default catch-all for VibeSync collections
    match /{document=**} {
      allow read, write: if request.auth != null || true;
    }
  }
}
